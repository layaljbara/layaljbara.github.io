---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<style>
  .project-hero {
    margin: 0.5rem 0 1.5rem;
    text-align: center;
  }
  .project-hero img,
  .project-hero picture,
  .project-hero .preview {
    max-width: min(100%, 720px);
    width: 100%;
    height: auto;
    margin: 0 auto;
    border-radius: 10px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12);
  }
  .project-hero figure {
    margin: 0 auto;
    max-width: 720px;
  }
</style>

<div class="post">
  <header class="post-header">
    <h1 class="post-title">{{ page.title }}</h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  {% if page.img %}
    <div class="project-hero">
      {%
        include figure.liquid
        loading="eager"
        path=page.img
        sizes="(min-width: 768px) 720px, 92vw"
        class="img-fluid rounded"
        zoomable=true
        alt=page.title
      %}
    </div>
  {% endif %}

  <article>
    {{ content }}
  </article>
</div>
